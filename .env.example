# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA - AVÍCOLA GR (BACKEND)
# Archivo: backend/.env.example
# ==============================================================================

PROJECT_NAME="Sistema de Planificación de Saca de Aves - Avícola GR"
ENVIRONMENT="production"
DEBUG=False
PORT=8000
API_V1_PREFIX="/api/v1"

# Orígenes permitidos para CORS (Frontend en Cloudflare Pages, local y dominios autorizados)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://*.pages.dev", "*"]

# ==============================================================================
# CREDENCIALES DE SUPABASE (Dashboard -> Project Settings -> API)
# ==============================================================================
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-secreta"
SUPABASE_JWT_SECRET="tu-jwt-secret-de-supabase"

# ==============================================================================
# CADENA DE CONEXIÓN A POSTGRESQL EN SUPABASE (Project Settings -> Database -> Connection string)
# ==============================================================================
# Modo Direct Connection (Puerto 5432 / asyncpg):
DATABASE_URL="postgresql+asyncpg://postgres:tu_password_aqui@db.tu-proyecto.supabase.co:5432/postgres?ssl=require"

# Modo Pooler / Transaction (Puerto 6543 - Opcional):
DATABASE_POOL_URL="postgresql+asyncpg://postgres.tu-proyecto:tu_password_aqui@aws-0-region.pooler.supabase.com:6543/postgres?ssl=require"

# ==============================================================================
# MOTOR DE INTELIGENCIA ARTIFICIAL • AGENTE ROXI (GOOGLE GEMINI 2.0 FLASH)
# ==============================================================================
# Clave de API obtenida en Google AI Studio (Costo $0.00 / Free Tier)
GEMINI_API_KEY="AIzaSy...tu_api_key_de_gemini"
GEMINI_MODEL="gemini-2.0-flash"
